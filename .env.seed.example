# Config for scripts/seed.mjs and scripts/security-check.mjs -> copy to .env.seed.local
# .env.seed.local is git-ignored. NEVER commit the service_role key and never
# give it a VITE_ prefix (that would put it into the frontend bundle).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon / publishable key>
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key, used by seed.mjs only>
SEED_PASSWORD=<password for the demo users>
